    .perf-hourly-total-row > span {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 0;
        padding: .45rem .65rem;
        border-right: 1px solid rgba(255, 255, 255, 0.14);
        font-weight: 700;
        line-height: 1.5;
    }

    .perf-hourly-total-row > span:last-child {
        border-right: 0;
    }

    .perf-hourly-total-label {
        position: relative;
        cursor: help;
    }

    .perf-hourly-total-label::before,
    .perf-hourly-total-label::after {
        position: absolute;
        z-index: 20;
        left: 68%;
        pointer-events: none;
        opacity: 0;
        visibility: hidden;
        transition: opacity .15s ease, transform .15s ease;
    }

    .perf-hourly-total-label::before {
        content: "";
        bottom: calc(100% + 2px);
        border: 7px solid transparent;
        border-top-color: #101f40;
        transform: translate(-50%, -3px);
    }

    .perf-hourly-total-label::after {
        content: attr(data-tooltip);
        bottom: calc(100% + 16px);
        width: max-content;
        max-width: 380px;
        padding: .65rem .85rem;
        border: 1px solid rgba(84, 199, 236, .48);
        border-radius: 7px;
        background: #101f40;
        box-shadow: 0 8px 22px rgba(0, 0, 0, .38);
        color: #ffffff;
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.35;
        white-space: nowrap;
        transform: translate(-12%, 4px);
    }

    .perf-hourly-total-label:hover::before,
    .perf-hourly-total-label:hover::after,
    .perf-hourly-total-label:focus-visible::before,
    .perf-hourly-total-label:focus-visible::after {
        opacity: 1;
        visibility: visible;
    }

    .perf-hourly-total-label:hover::before,
    .perf-hourly-total-label:focus-visible::before {
        transform: translate(-50%, 0);
    }

    .perf-hourly-total-label:hover::after,
    .perf-hourly-total-label:focus-visible::after {
        transform: translate(-12%, 0);
    }

    .perf-hourly-total-model {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .perf-hourly-total-value {
        color: #8ff0d0;
    }

    body.light-mode .perf-hourly-total-row {
        border-top-color: rgba(24, 112, 158, 0.65);
        background: linear-gradient(90deg, rgba(61, 121, 176, 0.94), rgba(48, 96, 150, 0.92));
    }
</style>

<div class="row mx-3 perf-page-shell">
    <form method="post" asp-page-handler="OnPost" class="w-100 mb-3">
        <div class="row">
            <div class="col-5 d-flex gap-2 align-items-center">
                <label class="fw-bold fs-5 perf-label">LINE</label>
                <select asp-for="MachineCode" class="form-select border-2 fs-5 fw-bold perf-select" id="MachineCode">
                    <option value="MCH1-01">CU Line</option>
                    <option value="MCH1-02">CS Line</option>
                </select>
            </div>
            <div class="col-5 d-flex gap-2 align-items-center">
                <label class="fw-bold fs-5 perf-label">DATE</label>
                <input asp-for="SelectedDate" type="date" class="form-control border-2 fs-5 fw-bold w-100 perf-date"
                       value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col align-items-center">
                <button type="submit" class="btn fs-5 fw-semibold btn-perf">FILTER</button>
            </div>
        </div>
    </form>

    <div class="col-5">
        <div class="text-center table-responsive perf-card p-0 m-0 @(Model.SelectedDate != DateTime.Now.Date ? "" : "refreshDailyData")">
            <table class="table rounded-2 overflow-hidden p-0 m-0">
                <tbody>
                    <tr>
                        <td colspan="2" class="perf-th fs-4 fw-bold w-50 py-3">PLAN</td>
                        <td class="perf-td fs-4 fw-bold w-50 py-3" id="val-planProd">@planProd</td>
                    </tr>
                    <tr>
                        <td colspan="2" class="perf-th fs-4 fw-bold w-50 py-3">TARGET</td>
                        <td class="perf-td fs-4 fw-bold w-50 py-3" id="val-targetProd">@targetProd</td>
                    </tr>
                    <tr>
                        <td colspan="2" class="perf-th fs-4 fw-bold w-50 py-3">ACTUAL</td>
                        <td class="perf-td fs-4 fw-bold w-50 py-3" id="val-actualProd">@actualProd</td>
                    </tr>
                    <tr>
                        <td colspan="2" class="perf-th fs-4 fw-bold w-50 py-3">DIFFERENCE</td>
                        <td class="perf-td fs-4 fw-bold w-50 py-3 @(differenceProd > 0 ? "" : "text-danger")" id="val-differenceProd">@differenceProd</td>
                    </tr>
                    <tr>
                        <td colspan="2" class="perf-th fs-4 fw-bold w-50 py-3">EFFICIENCY</td>
                        <td class="perf-td fs-4 fw-bold w-50 py-3" id="val-efficiencyValue">
                            @(efficiencyValue > 0 ? efficiencyValue : 0) %
                        </td>
                    </tr>
                    <tr>
                        <td rowspan="2" class="perf-th align-middle border border-end fs-4 fw-bold py-3">TAKE TIME</td>
                        <td class="perf-th fs-4 fw-bold py-3">PLAN</td>
                        <td class="perf-td fs-4 fw-bold py-3" id="val-planTaktTime">@planTaktTime s</td>
                    </tr>
                    <tr>
                        <td class="perf-th fs-4 fw-bold py-3">ACT</td>
                        <td class="perf-td fs-4 fw-bold py-3" id="val-actTaktTime">@(efficiencyMetrics.ActTaktTime > 0 ? efficiencyMetrics.ActTaktTime : 0) s</td>
                    </tr>
                    <tr>
                        <td colspan="2" class="perf-th fs-4 fw-bold w-50 py-3">PASS THROUGH RATIO</td>
                        <td class="perf-td fs-4 fw-bold w-50 py-3" id="val-defectRatio">@defectRatio %</td>
                    </tr>
                    <tr>
                        <td colspan="2" class="perf-th fs-4 fw-bold w-50 py-3">WORKING TIME</td>
                        <td class="perf-td fs-4 fw-bold w-50 py-3" id="val-workingTime">@(workingTime > 0 ? workingTime : 0) min</td>
                    </tr>
                    <tr>
                        <td colspan="2" class="perf-th fs-4 fw-bold w-50 py-3">LOSS TIME</td>
                        <td class="perf-td fs-4 fw-bold w-50 py-3" id="val-lossTime">@Math.Round(totalLossTime, 1) min</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-7 perf-dashboard-right">
        <div class="perf-panel perf-cycle-panel rounded-3 mb-3" style="contain: layout style;">
            <div class="perf-cycle-heading">
                <h2>CYCLE TIME</h2>
                <div class="perf-cycle-legend" aria-hidden="true">
                    <span><i class="perf-cycle-legend-line plan"></i>Plan SUT (s)</span>
                    <span><i class="perf-cycle-legend-line"></i>Actual Cycle (s)</span>
                </div>
            </div>
            <div class="perf-cycle-chart-wrap">
                <canvas id="PerformanceCycleTimeChart"></canvas>
            </div>
            <div class="perf-cycle-window-nav" aria-label="Navigasi periode cycle time">
                <button type="button" id="CycleWindowPrevious" title="Lihat 2 jam sebelumnya" aria-label="Lihat 2 jam sebelumnya">&#8249;</button>
                <span class="perf-cycle-window-label" id="CycleWindowLabel">--:--–--:--</span>
                <button type="button" id="CycleWindowNext" title="Lihat 2 jam berikutnya" aria-label="Lihat 2 jam berikutnya">&#8250;</button>
            </div>
        </div>

        <div class="text-center perf-panel perf-hourly-panel d-flex flex-column p-0 m-0 @(Model.SelectedDate != DateTime.Now.Date ? "" : "refreshHourlyAchievement")" style="contain: layout style;">
            <div class="row p-0 m-0">
                <label class="fs-2 text-center fw-bolder p-0 m-0 perf-panel-title">HOURLY ACHIEVEMENT</label>
            </div>
            <div class="perf-hourly-scroll row p-0 m-0 flex-grow-1">
                <table class="table border-2 p-0 m-0 fs-4 overflow-y-auto perf-hourly-table">
                    <colgroup>
                        <col style="width:32%" />
                        <col style="width:32%" />
                        <col style="width:18%" />
                        <col style="width:18%" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th scope="col" style="background-color: rgba(61, 121, 176, 0.82) !important; color: #ffffff !important;">TIME</th>
                            <th scope="col" style="background-color: rgba(61, 121, 176, 0.82) !important; color: #ffffff !important;">MODEL</th>
                            <th scope="col" style="background-color: rgba(61, 121, 176, 0.82) !important; color: #ffffff !important;">PLAN</th>
                            <th scope="col" style="background-color: rgba(61, 121, 176, 0.82) !important; color: #ffffff !important;">ACTUAL</th>
                        </tr>
                    </thead>
                    <tbody id="hourlyTableBody">
                        @if (sortedProdAchieve.Count > 0)
                        {
                            var previousTime = "";
                            var previousModel = "";

                            for (int i = 0; i < sortedProdAchieve.Count; i++)
                            {
                                        <tr>
                                    @if (previousTime != sortedProdAchieve[i].Time)
                                    {
                                                    <td rowspan="@timeCounts[sortedProdAchieve[i].Time]" class="fw-bold">
                                            @(sortedProdAchieve[i].Time ?? "00:00 - 00:00")
                                                    </td>
                                        previousTime = sortedProdAchieve[i].Time;
                                    }
                                            <td class="fw-bold">@(sortedProdAchieve[i].Model ?? "NULL")</td>
                                            <td class="fw-bold">
                                        @{
                                            var planPerHour = CalculatePlanPerHour(
                                                sortedProdAchieve[i].Model,
                                                previousModel,
                                                sortedProdAchieve[i].StartTime,
                                                sortedProdAchieve[i].EndTime,
                                                currentTime,
                                                currentDate,
                                                sortedProdAchieve[i].SUT,
                                                listRestTime
                                            );
                                            previousModel = sortedProdAchieve[i].Model;

                                            if (string.Equals(
                                                sortedProdAchieve[i].Model,
                                                Model.CurrentModelName,
                                                StringComparison.OrdinalIgnoreCase))
                                            {
                                                currentModelPlanTotal += planPerHour;
                                            }
                                        }
                                        @planPerHour
                                            </td>
                                            <td class="fw-bold">@(sortedProdAchieve[i].Actual != null ? sortedProdAchieve[i].Actual : 1)</td>
                                        </tr>
                            }
                        }
                        else
                        {
                                <tr>
                                    <td colspan="4" style="padding: 8px; text-align: center;">There is no actual data entered</td>
                                </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="perf-hourly-total-row fs-4">
                <span class="perf-hourly-total-label"
                      tabindex="0"
                      data-tooltip="Total dari model yang sedang berjalan saat ini">TOTAL</span>
                <span class="perf-hourly-total-model">@Model.CurrentModelName</span>
                <span>@currentModelPlanTotal</span>
                <span class="perf-hourly-total-value">@Model.CurrentModelTotal</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
        <script>
            let cycleTimeData = @(Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CycleTimeChartPoints)));

            const isLightMode = document.body.classList.contains('light-mode');
            const gridColor   = isLightMode ? 'rgba(0,0,0,0.08)'      : 'rgba(255,255,255,0.10)';
            const tickColor   = isLightMode ? '#1a1a2e'                : 'rgba(220,228,240,0.75)';

            const CYCLE_WINDOW_MINUTES = 120;
            let cycleWindowEndMinute = null;
            let cycleWindowPinnedToLatest = true;

            function cycleLabelToShiftMinute(label) {
                const parts = String(label || '').split(':').map(Number);
                if (parts.length < 2 || parts.some(Number.isNaN)) return null;

                let clockMinute = (parts[0] * 60) + parts[1] + ((parts[2] || 0) / 60);
                if (clockMinute < 7 * 60) clockMinute += 24 * 60;
                return clockMinute - (7 * 60);
            }

            function cycleShiftMinuteToTime(value) {
                const totalMinute = (7 * 60) + Math.max(0, Number(value) || 0);
                const hour = Math.floor(totalMinute / 60) % 24;
                const minute = Math.floor(totalMinute % 60);
                return `${String(hour).padStart(2, '0')}:${String(minute).padStart(2, '0')}`;
            }

            function getCycleTimeBounds(rawData) {
                const minutes = (rawData || [])
                    .map(point => cycleLabelToShiftMinute(point.Label))
                    .filter(value => value !== null);

                if (!minutes.length) return { hasData: false, min: 0, max: CYCLE_WINDOW_MINUTES };
                return {
                    hasData: true,
                    min: Math.min(...minutes),
                    max: Math.max(...minutes)
                };
            }

            function ensureCycleWindow(rawData, resetToLatest = false) {
                const bounds = getCycleTimeBounds(rawData);
                if (resetToLatest || cycleWindowEndMinute === null || cycleWindowPinnedToLatest) {
                    cycleWindowEndMinute = bounds.max;
                    cycleWindowPinnedToLatest = true;
                } else {
                    cycleWindowEndMinute = Math.max(0, Math.min(cycleWindowEndMinute, bounds.max));
                }
                return bounds;
            }

            function getCycleWindowData(rawData, bounds) {
                const windowEnd = cycleWindowEndMinute ?? bounds.max;
                const windowStart = Math.max(0, windowEnd - CYCLE_WINDOW_MINUTES);

                return (rawData || []).filter(point => {
                    const minute = cycleLabelToShiftMinute(point.Label);
                    if (minute === null) return false;
                    const afterStart = windowStart === 0 ? minute >= windowStart : minute > windowStart;
                    return afterStart && minute <= windowEnd;
                });
            }

            function formatCycleValue(value, maximumFractionDigits = 1) {
                return Number(value || 0).toLocaleString('id-ID', { maximumFractionDigits });
            }

            function buildCurrentCycleWindowView(resetToLatest = false) {
                const bounds = ensureCycleWindow(cycleTimeData, resetToLatest);
                const points = getCycleWindowData(cycleTimeData, bounds);
                const windowEnd = cycleWindowEndMinute ?? bounds.max;

                return {
                    bounds,
                    points,
                    labels: points.map(point => point.Label),
                    planData: points.map(point => point.PlanCycleTime),
                    actualData: points.map(point => point.ActualCycleTime),
                    windowEnd,
                    windowStart: Math.max(0, windowEnd - CYCLE_WINDOW_MINUTES)
                };
            }

            let cycleWindowView = buildCurrentCycleWindowView(true);

            Chart.Tooltip.positioners.cycleOffset = function(elements) {
                if (!elements.length) return false;

                const position = elements[0].element.tooltipPosition();
                const chartArea = this.chart.chartArea;
                const showOnRight = position.x < chartArea.left + (chartArea.width * 0.72);

                return {
                    x: position.x + (showOnRight ? 30 : -30),
                    y: position.y,
                    xAlign: showOnRight ? 'left' : 'right',
                    yAlign: 'center'
                };
            };

            const cycleHoverGuidePlugin = {
                id: 'cycleHoverGuide',
                beforeDatasetsDraw(chart) {
                    const activeElements = chart.getActiveElements();
                    if (!activeElements.length) return;

                    const x = activeElements[0].element.x;
                    const { ctx, chartArea } = chart;

                    ctx.save();
                    ctx.beginPath();
                    ctx.setLineDash([4, 4]);
                    ctx.moveTo(x, chartArea.top);
                    ctx.lineTo(x, chartArea.bottom);
                    ctx.lineWidth = 1.4;
                    ctx.strokeStyle = 'rgba(126, 226, 255, .72)';
                    ctx.stroke();
                    ctx.restore();
                }
            };

            const ctx = document.getElementById('PerformanceCycleTimeChart').getContext('2d');
            const performanceCycleChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: cycleWindowView.labels,
                    datasets: [
                        {
                            label: 'Plan SUT (s)',
                            data: cycleWindowView.planData,
                            borderColor: '#f6bd60',
                            backgroundColor: 'rgba(246, 189, 96, 0.12)',
                            borderWidth: 2,
                            borderDash: [7, 5],
                            pointRadius: 0,
                            pointHitRadius: 12,
                            pointHoverRadius: 5,
                            pointHoverBackgroundColor: '#f6bd60',
                            pointHoverBorderColor: '#ffffff',
                            pointHoverBorderWidth: 2,
                            stepped: true,
                            tension: 0
                        },
                        {
                            label: 'Actual Cycle (s)',
                            data: cycleWindowView.actualData,
                            borderColor: '#54c7ec',
                            backgroundColor: 'rgba(84, 199, 236, 0.12)',
                            borderWidth: 1.6,
                            pointRadius: 0,
                            pointHitRadius: 12,
                            pointHoverRadius: 6,
                            pointHoverBackgroundColor: '#54c7ec',
                            pointHoverBorderColor: '#ffffff',
                            pointHoverBorderWidth: 2,
                            tension: 0.12
                        }
                    ]
                },
                plugins: [cycleHoverGuidePlugin],
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: { duration: 350 },
                    interaction: { mode: 'index', intersect: false },
                    layout: { padding: { bottom: 4 } },
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            position: 'cycleOffset',
                            padding: 12,
                            caretSize: 7,
                            caretPadding: 10,
                            boxWidth: 14,
                            boxHeight: 14,
                            titleFont: {
                                size: 15,
                                weight: 'bold'
                            },
                            bodyFont: {
                                size: 14,
                                weight: '600'
                            },
                            titleSpacing: 4,
                            bodySpacing: 5,
                            callbacks: {
                                title(items) {
                                    const index = items[0]?.dataIndex ?? 0;
                                    const point = cycleWindowView.points[index];
                                    return point ? `${point.Label} · ${point.ModelProduk}` : '';
                                },
                                label(context) {
                                    const point = cycleWindowView.points[context.dataIndex];
                                    if (!point) return '';
                                    const value = context.datasetIndex === 0
                                        ? point.PlanCycleTime
                                        : point.ActualCycleTime;
                                    return `${context.dataset.label}: ${formatCycleValue(value)}`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            ticks: {
                                color: tickColor,
                                autoSkip: true,
                                autoSkipPadding: 20,
                                maxTicksLimit: 8,
                                maxRotation: 0,
                                minRotation: 0,
                                callback(value) {
                                    return this.getLabelForValue(value).substring(0, 5);
                                }
                            },
                            grid: { color: gridColor }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: {
                                color: tickColor,
                                callback(value) { return `${formatCycleValue(value, 0)} s`; }
                            },
                            grid: { color: gridColor }
                        }
                    }
                },
            });

            window.performanceCycleChart = performanceCycleChart;

            function updateCycleWindowControls() {
                const previousButton = document.getElementById('CycleWindowPrevious');
                const nextButton = document.getElementById('CycleWindowNext');
                const label = document.getElementById('CycleWindowLabel');
                const bounds = cycleWindowView.bounds;

                label.textContent = `${cycleShiftMinuteToTime(cycleWindowView.windowStart)}–${cycleShiftMinuteToTime(cycleWindowView.windowEnd)}`;
                previousButton.disabled = !bounds.hasData || cycleWindowView.windowStart <= bounds.min;
                nextButton.disabled = !bounds.hasData || cycleWindowPinnedToLatest || cycleWindowView.windowEnd >= bounds.max;
            }

            function updateCycleWindowChart(resetToLatest = false) {
                cycleWindowView = buildCurrentCycleWindowView(resetToLatest);

                performanceCycleChart.data.labels = cycleWindowView.labels;
                performanceCycleChart.data.datasets[0].data = cycleWindowView.planData;
                performanceCycleChart.data.datasets[1].data = cycleWindowView.actualData;
                updateCycleWindowControls();
                performanceCycleChart.update('none');
            }

            document.getElementById('CycleWindowPrevious').addEventListener('click', () => {
                const bounds = getCycleTimeBounds(cycleTimeData);
                if (!bounds.hasData) return;

                const currentEnd = cycleWindowEndMinute ?? bounds.max;
                cycleWindowEndMinute = Math.max(0, currentEnd - CYCLE_WINDOW_MINUTES);
                cycleWindowPinnedToLatest = false;
                updateCycleWindowChart();
            });

            document.getElementById('CycleWindowNext').addEventListener('click', () => {
                const bounds = getCycleTimeBounds(cycleTimeData);
                if (!bounds.hasData) return;

                const currentEnd = cycleWindowEndMinute ?? bounds.max;
                cycleWindowEndMinute = Math.min(bounds.max, currentEnd + CYCLE_WINDOW_MINUTES);
                cycleWindowPinnedToLatest = cycleWindowEndMinute >= bounds.max;
                updateCycleWindowChart();
            });

            updateCycleWindowControls();

            async function autoRefreshPageViaHTML() {
                try {
                    const machineCode  = document.getElementById('MachineCode').value;
                    const selectedDate = document.querySelector('input[name="SelectedDate"]').value;
                    // Build the URL to fetch the full page
                    const currentUrl = window.location.pathname;
                    const url = `${currentUrl}?MachineCode=${machineCode}&SelectedDate=${selectedDate}`;
                    
                    const response = await fetch(url);
                    if (!response.ok) throw new Error(`HTTP error! Status: ${response.status}`);
                    
                    const htmlText = await response.text();
                    
                    // Parse the HTML
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(htmlText, 'text/html');

                    // 1. Update Metrics Table
                    const oldMetrics = document.querySelector('.perf-card');
                    const newMetrics = doc.querySelector('.perf-card');
                    if(oldMetrics && newMetrics) {
                        oldMetrics.innerHTML = newMetrics.innerHTML;
                    }

                    // 2. Update Hourly Table
                    const oldHourly = document.querySelector('.perf-hourly-table');
                    const newHourly = doc.querySelector('.perf-hourly-table');
                    if(oldHourly && newHourly) {
                        oldHourly.innerHTML = newHourly.innerHTML;
                    }

                    const oldHourlyTotal = document.querySelector('.perf-hourly-total-row');
                    const newHourlyTotal = doc.querySelector('.perf-hourly-total-row');
                    if(oldHourlyTotal && newHourlyTotal) {
                        oldHourlyTotal.innerHTML = newHourlyTotal.innerHTML;
                        oldHourlyTotal.title = newHourlyTotal.title;
                    }

                    // 3. Update Cycle Time Chart dari HTML terbaru.
                    const cycleMatch = htmlText.match(/let cycleTimeData\s*=\s*(\[.*?\]);/);
                    if (cycleMatch && cycleMatch[1]) {
                        cycleTimeData = JSON.parse(cycleMatch[1]);
                        updateCycleWindowChart();
                    }

                } catch (error) {
                    console.error("Auto-refresh via HTML failed:", error.message);
                }
            }

            // Panggil otomatis jika user ubah filter
            async function refreshWithLatestCycleWindow() {
                cycleWindowEndMinute = null;
                cycleWindowPinnedToLatest = true;
                await autoRefreshPageViaHTML();
            }

            document.getElementById('MachineCode').addEventListener('change', refreshWithLatestCycleWindow);
            document.querySelector('input[name="SelectedDate"]').addEventListener('change', refreshWithLatestCycleWindow);

            // Jalankan proses load setiap 5 detik
            setInterval(autoRefreshPageViaHTML, 5000);
        </script>
}
