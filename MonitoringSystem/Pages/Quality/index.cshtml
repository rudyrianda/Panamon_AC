@page
@model MonitoringSystem.Pages.Quality.QualityModel
@{
    ViewData["Title"] = "Pass Through Ratio";
    /* Pa Adan Disini */
    // Page awan baik
    var line = Model.Line;
    var fiscalYear = Model.ChartYear;
}

<link rel="stylesheet" href="~/css/quality-defect.css" asp-append-version="true" />

<div id="targetModal" class="modal">
    <div class="modal-content">
        <span class="close-button">&times;</span>
        <h4 class="fw-bold" style="color: var(--panasonic-blue);">Update Target Ratio</h4>
        <hr />
        <form method="post" asp-page-handler="UpdateTargetRatio">
            <div class="form-group">
                <label for="target-input" class="fw-semibold">New Target Ratio (%)</label>
                <input type="number" step="0.01" class="form-control" id="target-input" asp-for="NewTargetRatio" required placeholder="1.5">
            </div>
            <input type="hidden" name="MachineCode" value="@Model.MachineCode" />
            <input type="hidden" name="StartDate" value="@Model.StartDate" />
            <input type="hidden" name="EndDate" value="@Model.EndDate" />
            <input type="hidden" name="Station" value="@Model.Station" />
            <button type="submit" class="btn btn-primary mt-3 fw-bold" style="background-color: var(--panasonic-blue); border:none;">Save Target</button>
        </form>
    </div>
</div>

<div class="container-fluid dashboard-container quality-dashboard">
    <form method="post">
        <div class="row g-3 quality-main-row">
            <div class="col-md-2 quality-filter-column">
                <div class="grid-border">
                    <label for="lineDropdown" class="quality-line-label">SELECT LINE</label>
                    <select id="lineDropdown" name="MachineCode" class="form-control quality-line-select" onchange="this.form.submit();">
                        @foreach (var option in MonitoringSystem.Pages.Quality.QualityDefectCatalog.Lines)
                        {
                            <option value="@option.Code" selected="@(option.Code == line.Code)">@option.Code (@option.MachineCode)</option>
                        }
                        <option value="">CB</option>
                        <option value="">EVA</option>
                        <option value="">COND</option>
                    </select>
                </div>

                <div class="grid-border quality-station-panel">
                    <div class="section-title" style="font-size:1rem;">STATION</div>
                    <div class="btn-custom-group">
                        <button type="submit" name="Station" value="" class="@(string.IsNullOrEmpty(Model.Station) ? "btn-blue-active" : "btn-outline-inactive")">ALL STATION</button>
                        @foreach (var station in line.Stations)
                        {
                            <button type="submit" name="Station" value="@station.Key" class="@(Model.Station == station.Key ? "btn-blue-active" : "btn-outline-inactive")">@station.Label</button>
                        }
                    </div>
                </div>

                <div class="grid-border">
                    <div class="section-title" style="font-size:1rem;">DAILY FILTER</div>
                    <div class="mb-2">
                        <label class="fw-bold text-muted" style="font-size:0.8rem;">START DATE</label>
                        <input class="form-control" type="date" asp-for="StartDate">
                    </div>
                    <div class="mb-2">
                        <label class="fw-bold text-muted" style="font-size:0.8rem;">END DATE</label>
                        <input class="form-control" type="date" asp-for="EndDate">
                    </div>
                    <button type="submit" name="Station" value="@Model.Station" class="btn btn-blue-active">APPLY FILTER</button>
                </div>
            </div>

            <div class="col-md-10 quality-content-column">

                <div class="row g-2 quality-kpi-row">
                    <div class="col-md-3">
                        <div class="kpi-box">
                            <div class="kpi-header">TARGET RATIO</div>
                            <div class="kpi-value" id="openModalButton" style="cursor: pointer;">
                                @String.Format("{0:0.00}", Model.CurrentTargetRatio) %
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="kpi-box">
                            <div class="kpi-header">DEFECT QUANTITY</div>
                            <div class="kpi-value">@Model.DefectQuantity</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="kpi-box">
                            <div class="kpi-header">PASS THROUGH RATIO</div>
                            @{
                                var ratioColor = "";
                                if (Model.DefectRatio <= (100 - Model.CurrentTargetRatio)) { ratioColor = "color: red !important;"; }
                            }
                            <div class="kpi-value" style="@ratioColor">
                                @String.Format("{0:0.00}", Model.DefectRatio) %
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="kpi-box">
                            <div class="kpi-header">TOTAL OUTPUT</div>
                            <div class="kpi-value">@Model.TotalPlan</div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 quality-upper-charts">
                    <div class="col-md-5">
                        <div class="grid-border fill-height">
                            <div class="section-title">DEFECT CLASSIFICATION (BY STATION)</div>
                            <div class="quality-chart-body flex-grow-1">
                                <canvas id="pieStation"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-7 quality-causes-col">
                        <div class="grid-border fill-height">
                            <div class="section-title">DEFECT CAUSES</div>
                            <div class="quality-causes-body flex-grow-1">
                                <div class="quality-causes-side">
                                    <select id="causeStation" class="quality-cause-select" aria-label="Station defect causes">
                                        <option value="ALL" selected="@string.IsNullOrEmpty(Model.Station)">All Station</option>
                                        @foreach (var station in Model.StationBreakdown)
                                        {
                                            <option value="@station.Key" selected="@(Model.Station == station.Key)">@station.Label</option>
                                        }
                                    </select>
                                    <table class="quality-category-table">
                                        <thead>
                                            <tr><th>Categorize</th><th>Qty</th><th></th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var category in line.Categories)
                                            {
                                                <tr data-category="@category.Key">
                                                    <td>@category.Label</td>
                                                    <td class="qty" data-qty-for="@category.Key">0</td>
                                                    <td class="pick">
                                                        <input type="radio" name="causeCategory" value="@category.Key" aria-label="@category.Label" />
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <div class="quality-chart-body quality-causes-chart">
                                    <canvas id="barCauses"></canvas>
                                    <div id="barCausesEmpty" class="quality-empty" hidden>Tidak ada defect</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-0 quality-yearly-chart">
                    <div class="col-12">
                        <div class="grid-border fill-height">
                            <div class="quality-monthly-header">
                                <span></span>
                                <div class="quality-monthly-title">Monthly Defect @line.Code - FY@(fiscalYear)</div>
                                <a class="quality-summary-link" asp-page="/Quality/Summary" asp-route-line="@line.Code" asp-route-fy="@fiscalYear">&gt;&gt; View Summary Defect Data Table</a>
                            </div>
                            <div class="quality-chart-body flex-grow-1">
                                <canvas id="barMonthly"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </form>
</div>

<script src="~/js/chart.umd.min.js"></script>
<script>
    const stationBreakdown = @Html.Raw(Json.Serialize(Model.StationBreakdown));
    const causesByStation = @Html.Raw(Json.Serialize(Model.CausesByStation));
    const yearlyDefectsRaw = @Html.Raw(Json.Serialize(Model.YearlyDefects));

    const colorPalette = [
        'rgba(255, 99, 132, 0.7)', 'rgba(54, 162, 235, 0.7)',
        'rgba(255, 206, 86, 0.7)', 'rgba(75, 192, 192, 0.7)',
        'rgba(153, 102, 255, 0.7)', 'rgba(255, 159, 64, 0.7)',
        'rgba(255, 99, 255, 0.7)', 'rgba(99, 255, 132, 0.7)',
        'rgba(132, 99, 255, 0.7)', 'rgba(235, 162, 54, 0.7)'
    ];

    const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

    const yearlyDefectCauses = [...new Set(yearlyDefectsRaw.map(d => d.cause))];
    const yearlyDatasets = yearlyDefectCauses.map((cause, index) => ({
        label: cause,
        data: monthNames.map((_, monthIndex) => {
            const entry = yearlyDefectsRaw.find(d => d.month === monthIndex + 1 && d.cause === cause);
            return entry ? entry.quantity : 0;
        }),
        backgroundColor: colorPalette[index % colorPalette.length]
    }));

    document.addEventListener("DOMContentLoaded", function () {

        const isLight = document.body.classList.contains('light-mode');
        const chartTextColor = isLight ? '#1a1a2e' : '#ffffff';
        const accentTextColor = isLight ? '#1a1a2e' : '#ffe14d';
        const chartGridColor = isLight ? 'rgba(0,0,0,0.1)' : 'rgba(255,255,255,0.10)';
        Chart.defaults.color = chartTextColor;
        Chart.defaults.borderColor = chartGridColor;

        new Chart(document.getElementById('pieStation'), {
            type: 'pie',
            data: {
                labels: stationBreakdown.map(s => s.label),
                datasets: [{
                    data: stationBreakdown.map(s => s.quantity),
                    backgroundColor: colorPalette,
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'right',
                        labels: { color: accentTextColor, font: { size: 12, weight: 'bold' } }
                    },
                    tooltip: { callbacks: { label: ctx => `${ctx.label}: ${ctx.parsed}` } }
                }
            }
        });

        // ---- Defect Causes: station dropdown + kategori (radio) -> top item defect ----
        const causeStation = document.getElementById('causeStation');
        const causeRadios = document.querySelectorAll('input[name="causeCategory"]');
        const causesEmpty = document.getElementById('barCausesEmpty');
        const causesChart = new Chart(document.getElementById('barCauses'), {
            type: 'bar',
            data: { labels: [], datasets: [{ label: 'Qty', data: [], backgroundColor: 'rgba(54, 162, 235, 0.7)', borderWidth: 1 }] },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: ctx => `Qty: ${ctx.parsed.x}` } }
                },
                scales: {
                    x: { beginAtZero: true, ticks: { precision: 0, color: chartTextColor } },
                    y: { ticks: { color: accentTextColor, font: { weight: 'bold' } } }
                }
            }
        });

        function selectedCategory() {
            const checked = document.querySelector('input[name="causeCategory"]:checked');
            return checked ? checked.value : null;
        }

        function renderCauses(pickLargest) {
            const categories = causesByStation[causeStation.value] || {};
            document.querySelectorAll('[data-qty-for]').forEach(cell => {
                const info = categories[cell.dataset.qtyFor];
                cell.textContent = info ? info.total : 0;
            });

            if (pickLargest || !selectedCategory()) {
                let best = causeRadios[0];
                causeRadios.forEach(radio => {
                    const total = (categories[radio.value] || {}).total || 0;
                    const bestTotal = (categories[best.value] || {}).total || 0;
                    if (total > bestTotal) best = radio;
                });
                if (best) best.checked = true;
            }

            const items = ((categories[selectedCategory()] || {}).items) || [];
            causesChart.data.labels = items.map(i => i.cause);
            causesChart.data.datasets[0].data = items.map(i => i.quantity);
            causesChart.update();
            causesEmpty.hidden = items.length > 0;
            document.querySelectorAll('.quality-category-table tbody tr').forEach(row => {
                row.classList.toggle('is-selected', row.dataset.category === selectedCategory());
            });
        }

        causeStation.addEventListener('change', () => renderCauses(true));
        causeRadios.forEach(radio => radio.addEventListener('change', () => renderCauses(false)));
        document.querySelectorAll('.quality-category-table tbody tr').forEach(row => {
            row.addEventListener('click', () => {
                const radio = row.querySelector('input[type="radio"]');
                radio.checked = true;
                renderCauses(false);
            });
        });
        renderCauses(true);

        new Chart(document.getElementById('barMonthly'), {
            type: 'bar',
            data: {
                labels: monthNames,
                datasets: yearlyDatasets
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: { mode: 'index', intersect: false, filter: item => item.parsed.y > 0 }
                },
                scales: {
                    x: { stacked: true, ticks: { color: chartTextColor } },
                    y: { stacked: true, beginAtZero: true, ticks: { color: chartTextColor, precision: 0 } }
                }
            }
        });

        var modal = document.getElementById('targetModal');
        var openModalButton = document.getElementById('openModalButton');
        var closeButton = document.getElementsByClassName('close-button')[0];
        openModalButton.onclick = function () { modal.style.display = 'block'; }
        closeButton.onclick = function () { modal.style.display = 'none'; }
        window.onclick = function (event) {
            if (event.target == modal) { modal.style.display = 'none'; }
        }
    });
</script>
