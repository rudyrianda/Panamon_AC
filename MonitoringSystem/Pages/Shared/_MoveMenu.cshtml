@*
    Tombol "Move" di sidebar untuk pindah antar modul (RAC / CAC / MACHINE).
    Modul aktif dideteksi dari URL, popup hanya menampilkan 2 modul lainnya.
    CSS & JS dibuat mandiri karena dipakai juga oleh ACOEE Dashboard (Layout = null).
*@
@{
    var movePath = (Context.Request.Path.Value ?? string.Empty).ToLowerInvariant();
    string currentModule =
        movePath.StartsWith("/cac") ? "CAC" :
        (movePath.StartsWith("/acoee") || movePath.StartsWith("/planmachine") || movePath.StartsWith("/planbrazing") || movePath.StartsWith("/planfinpress") || movePath.StartsWith("/planpressshop")) ? "MACHINE" :
        "RAC";

    // Ikon RAC & CAC sebagai SVG langsung (tanpa library/internet):
    //   RAC = Tabler "air-conditioning" (MIT), CAC = Material Symbols "air_purifier_gen" (Apache 2.0)
    const string racSvg = "<svg class=\"move-card-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8 16a3 3 0 0 1 -3 3\"/><path d=\"M16 16a3 3 0 0 0 3 3\"/><path d=\"M12 16v4\"/><path d=\"M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v4a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2l0 -4\"/><path d=\"M7 13v-3a1 1 0 0 1 1 -1h8a1 1 0 0 1 1 1v3\"/></svg>";
    const string cacSvg = "<svg class=\"move-card-icon\" viewBox=\"0 -960 960 960\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M120-120v-600q0-50 35-85t85-35h160q50 0 85 35t35 85v600H120Zm280-240h40v-200h-40v200ZM200-200h240v-80h-40q-33 0-56.5-23.5T320-360v-200q0-33 23.5-56.5T400-640h40v-80q0-17-11.5-28.5T400-760H240q-17 0-28.5 11.5T200-720v520Zm488-217q-26 0-51-7t-49-18l25-76q20 9 39.5 15t36.5 6q12 0 24-4t25-12q24-17 48-23t46-6q25 0 51.5 6.5T933-518l-25 76q-23-8-42.5-14t-33.5-6q-12 0-26.5 4.5T775-442q-21 14-42.5 19.5T688-417Zm1-156q-26 0-52-7t-49-18l25-76q26 11 44 16t32 5q12 0 24-3.5t25-12.5q25-17 48.5-23t45.5-6q25 0 50 6.5t51 17.5l-25 76q-26-9-44-14.5t-32-5.5q-13 0-26.5 4T775-598q-18 13-40.5 19t-45.5 6Zm0 312q-26 0-51.5-7T588-286l25-76q22 10 41 15.5t35 5.5q12 0 24-3.5t25-12.5q23-16 49-22.5t46-6.5q25 0 51 7t49 17l-25 76q-26-9-44.5-14.5T832-306q-14 0-28.5 4.5T775-286q-17 12-39.5 18.5T689-261Zm-249 61v-528.5 8.5-8.5V-200Z\"/></svg>";

    var moveTargets = new[]
    {
        new { Key = "RAC", Href = "/ProductionReport/index", Icon = "", Svg = racSvg, Desc = "Production Monitoring RAC", Css = "move-card-rac" },
        new { Key = "CAC", Href = "/CAC/ProductionReport/index", Icon = "", Svg = cacSvg, Desc = "Production Monitoring CAC", Css = "move-card-cac" },
        new { Key = "MACHINE", Href = "/ACOEE/dashboard", Icon = "fa-gears", Svg = "", Desc = "Production Monitoring Machine", Css = "move-card-machine" }
    }.Where(t => t.Key != currentModule);
}

<li class="nav-item" id="moveNavItem" style="position: relative;">
    <a href="#" id="moveMenuBtn" title="Pindah ke modul lain">
        <i class="fa-solid fa-right-left"></i>
        <span class="nav-label">Move</span>
    </a>
    <div id="moveMenuPopup" class="sidebar-move-popup" role="menu">
        @foreach (var t in moveTargets)
        {
            <a class="move-card @t.Css" href="@t.Href" role="menuitem">
                @if (t.Svg.Length > 0)
                {
                    @Html.Raw(t.Svg)
                }
                else
                {
                    <i class="fa-solid @t.Icon"></i>
                }
                <span class="move-card-name">@t.Key</span>
                <span class="move-card-desc">@t.Desc</span>
            </a>
        }
    </div>
</li>

<style>
    #bdSidebar .sidebar-move-popup {
        display: none;
        flex-direction: column;
        gap: 8px;
        position: absolute;
        left: 100%;
        top: 0;
        margin-left: 8px;
        padding: 8px;
        min-width: 170px;
        background: #1c2440 !important;
        border: 1px solid rgba(255, 255, 255, 0.35);
        border-radius: 10px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.55);
        z-index: 9999;
    }

        #bdSidebar .sidebar-move-popup.open {
            display: flex;
        }

    #bdSidebar .nav-item .sidebar-move-popup a.move-card {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 4px;
        width: 100% !important;
        height: auto !important;
        min-height: 84px;
        padding: 12px 10px !important;
        background: rgba(255, 255, 255, 0.05) !important;
        border: 2px solid rgba(255, 255, 255, 0.12) !important;
        border-radius: 10px !important;
        color: #ffffff !important;
        opacity: 1 !important;
        text-decoration: none !important;
        transition: border-color .15s ease, background .15s ease, transform .15s ease !important;
    }

        #bdSidebar .nav-item .sidebar-move-popup a.move-card:hover {
            transform: translateX(2px);
        }

        #bdSidebar .nav-item .sidebar-move-popup a.move-card i {
            font-size: 24px;
            margin: 0;
        }

    #bdSidebar .sidebar-move-popup .move-card-name {
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 1.5px;
        line-height: 1.1;
    }

    #bdSidebar .sidebar-move-popup .move-card-desc {
        font-size: 9.5px;
        font-weight: 500;
        line-height: 1.2;
        text-align: center;
        opacity: .65;
    }

    #bdSidebar .sidebar-move-popup .move-card-icon {
        width: 26px;
        height: 26px;
        flex-shrink: 0;
    }

    #bdSidebar .sidebar-move-popup .move-card-rac i,
    #bdSidebar .sidebar-move-popup .move-card-rac .move-card-icon { color: #4fc3f7 !important; }
    #bdSidebar .sidebar-move-popup .move-card-cac i,
    #bdSidebar .sidebar-move-popup .move-card-cac .move-card-icon { color: #f39c12 !important; }
    #bdSidebar .sidebar-move-popup .move-card-machine i { color: #2ecc71 !important; }

    #bdSidebar .nav-item .sidebar-move-popup a.move-card-rac:hover {
        border-color: #4fc3f7 !important;
        background: rgba(79, 195, 247, 0.15) !important;
    }

    #bdSidebar .nav-item .sidebar-move-popup a.move-card-cac:hover {
        border-color: #f39c12 !important;
        background: rgba(243, 156, 18, 0.15) !important;
    }

    #bdSidebar .nav-item .sidebar-move-popup a.move-card-machine:hover {
        border-color: #2ecc71 !important;
        background: rgba(46, 204, 113, 0.15) !important;
    }

    body.light-mode #bdSidebar .sidebar-move-popup,
    body.light-theme #bdSidebar .sidebar-move-popup {
        background: #ffffff !important;
        border-color: rgba(26, 26, 46, 0.2);
        box-shadow: 0 8px 24px rgba(26, 26, 46, 0.25);
    }

    body.light-mode #bdSidebar .nav-item .sidebar-move-popup a.move-card,
    body.light-theme #bdSidebar .nav-item .sidebar-move-popup a.move-card {
        color: #1a1a2e !important;
        background: rgba(26, 26, 46, 0.03) !important;
        border-color: rgba(26, 26, 46, 0.15) !important;
    }
</style>

<script>
    (function () {
        var btn = document.getElementById('moveMenuBtn');
        var popup = document.getElementById('moveMenuPopup');
        if (!btn || !popup) return;

        function close() {
            popup.classList.remove('open');
            popup.style.top = '';
        }

        btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            if (popup.classList.contains('open')) { close(); return; }

            popup.classList.add('open');
            // Geser ke atas kalau popup terpotong di bawah layar.
            var overflow = popup.getBoundingClientRect().bottom - (window.innerHeight - 8);
            if (overflow > 0) popup.style.top = (-overflow) + 'px';
        });

        document.addEventListener('click', function (e) {
            if (!btn.contains(e.target) && !popup.contains(e.target)) close();
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') close();
        });
    })();
</script>
