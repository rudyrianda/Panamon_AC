@page "/ACOEE/Inventory"
@model MonitoringSystem.Pages.ACOEE.InventoryModel
@{
    ViewData["Title"] = "Inventory";
    Layout = null;

    int daysInMonth = DateTime.DaysInMonth(Model.ActiveYear, Model.ActiveBulan);

    string[] namaBulan = new[]
    {
        "Januari", "Februari", "Maret", "April", "Mei", "Juni",
        "Juli", "Agustus", "September", "Oktober", "November", "Desember"
    };

    string[] machineLines = new[]
    {
        "Evaporator",
        "Condenser",
        "400 Ton New",
        "300 Ton New",
        "300 Ton Old",
        "200 Ton",
        "110 Ton Amada",
        "110 Ton Komatsu",
        "Hairpin Bender 7row",
        "Hairpin Bender 14row",
        "Fix 80",
        "Fix 36",
        "Fix 12",
        "SF-250",
        "Expander Kyoshin 7",
        "Expander Kyoshin 6.35",
        "Expander Li-chin"
    };

    var dailyTotals = new Dictionary<int, decimal>();
    for (int d = 1; d <= daysInMonth; d++)
    {
        dailyTotals[d] = Model.DailyTotals.TryGetValue(d, out var total) ? total : 0;
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AC OEE Inventory - PANAMON</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/sweetalert2.css" />
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/background-style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ac-oee.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/inventory.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ac-oee-inventory.css" asp-append-version="true" />
</head>
<body class="ac-oee-page ac-oee-inventory-page">
<div class="oee-shell">
    <header class="oee-header">
        <a class="panasonic-brand" href="/" aria-label="Panasonic home">
            <img src="~/assets/PanasonicIcon.png" alt="Panasonic" />
        </a>
        <div class="ac-oee-header-title">AC OEE</div>
        <div class="header-meta">
            <button class="theme-chip" id="oeeThemeToggle" type="button" aria-label="Toggle color theme">
                <span class="theme-moon">●</span>
                <span id="oeeThemeLabel">Dark</span>
            </button>
            <span id="oeeDate"></span>
            <span id="oeeTime"></span>
        </div>
    </header>

    <div class="oee-body">
        <aside class="oee-sidebar" aria-label="AC OEE navigation">
            <nav>
                <a class="side-link" href="/ACOEE">
                    <i class="fa-solid fa-fan"></i><span>Dashboard</span>
                </a>
                <a class="side-link" href="/ACOEE/ProductionData">
                    <i class="fa-solid fa-chart-column"></i><span>Production<br />Data</span>
                </a>
                <a class="side-link" href="/LossTimeReport/index">
                    <i class="fa-regular fa-clock"></i><span>Downtime<br />History</span>
                </a>
                <a class="side-link active" href="/ACOEE/Inventory" aria-current="page">
                    <i class="fa-solid fa-cube"></i><span>Inventory<br />Data</span>
                </a>
            </nav>
            <div class="sidebar-divider"></div>
            <a class="sidebar-collapse" href="/" aria-label="Return to Panamon">
                <i class="fa-solid fa-angles-left"></i>
            </a>
        </aside>

        <main class="oee-main inventory-main">
            <h1 class="inventory-page-title">Inventory Data</h1>

<div class="filter-area-with-lines">
    <div class="panamon-bottom-line"></div>
    <div class="panamon-bottomm-line"></div>
    <div class="filter-content">
        <div class="row g-3 align-items-center justify-content-between flex-wrap">
            <div class="col-auto">
                <form method="get" class="d-flex flex-wrap align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2 inventory-filter-group">
                        <label class="mb-0">Bulan</label>
                        <select class="form-select" style="width: 130px;" name="FilterBulan">
                            @for (int b = 1; b <= 12; b++)
                            {
                                <option value="@b" selected="@(b == Model.ActiveBulan)">@namaBulan[b - 1]</option>
                            }
                        </select>
                    </div>
                    <div class="d-flex align-items-center gap-2 inventory-filter-group">
                        <label class="mb-0">Tahun</label>
                        <input type="number" class="form-control" style="width: 90px;"
                               name="FilterTahun" value="@Model.ActiveYear" min="2000" max="2100" />
                    </div>
                    <div class="d-flex align-items-center gap-2 inventory-filter-group">
                        <label class="mb-0">Machine</label>
                        <select class="form-select" style="width: 190px;" name="FilterMachineLine">
                            <option value="" selected="@(string.IsNullOrEmpty(Model.FilterMachineLine))">All</option>
                            @foreach (var machineLine in machineLines)
                            {
                                <option value="@machineLine" selected="@(Model.FilterMachineLine == machineLine)">@machineLine</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Search</button>
                    <a href="/ACOEE/Inventory" class="btn btn-danger">Reset</a>
                    <button type="button" class="btn btn-success" id="btn-export-csv">Save Excel</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="inv-card">
    <div id="inventory-report">
        <div class="inv-table-container">
            <div class="inv-header-wrap">
                <table class="table table-bordered mb-0 inv-tbl">
                    <colgroup>
                        <col class="col-model" />
                        @for (int d = 1; d <= daysInMonth; d++)
                        {
                            <col class="col-day" />
                        }
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="col-model">Model</th>
                            @for (int d = 1; d <= daysInMonth; d++)
                            {
                                <th class="col-day text-center">@d</th>
                            }
                        </tr>
                    </thead>
                </table>
            </div>

            <div class="inv-body-wrap">
                <table class="table table-bordered mb-0 inv-tbl">
                    <colgroup>
                        <col class="col-model" />
                        @for (int d = 1; d <= daysInMonth; d++)
                        {
                            <col class="col-day" />
                        }
                    </colgroup>
                    <tbody id="inventory-table-body">
                        @{
                            int minRows = 15;
                            int dataCount = Model.listData?.Count ?? 0;
                            int totalRows = Math.Max(dataCount, minRows);
                        }

                        @for (int i = 0; i < totalRows; i++)
                        {
                            var item = dataCount > i ? Model.listData[i] : null;

                            <tr>
                                <td class="col-model">@(item?.Model ?? "")</td>

                                @for (int d = 1; d <= daysInMonth; d++)
                                {
                                    decimal? dayValue = null;
                                    if (item?.DailyValues != null && item.DailyValues.ContainsKey(d))
                                    {
                                        dayValue = item.DailyValues[d];
                                    }

                                    <td class="col-day text-center">@(dayValue?.ToString() ?? "")</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="inv-footer-wrap">
                <table class="table table-bordered mb-0 inv-tbl">
                    <colgroup>
                        <col class="col-model" />
                        @for (int d = 1; d <= daysInMonth; d++)
                        {
                            <col class="col-day" />
                        }
                    </colgroup>
                    <tfoot>
                        <tr>
                            <td class="col-model">Total</td>
                            @for (int d = 1; d <= daysInMonth; d++)
                            {
                                <td class="col-day text-center">@(dailyTotals[d] == 0 ? "" : dailyTotals[d].ToString("0.##"))</td>
                            }
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    window.__invStatusMessage = '@TempData["StatusMessage"]';
    window.__invMessage = '@TempData["Message"]';
</script>
        </main>
    </div>

    <footer class="oee-footer">
        &copy;2026 - Panasonic Manufacturing Indonesia (PMI) - Air Conditioner
    </footer>
</div>

<script src="~/js/sweetalert2.min.js"></script>
<script src="~/js/ac-oee.js" asp-append-version="true"></script>
<script src="~/js/inventory-export.js" asp-append-version="true"></script>
</body>
</html>
