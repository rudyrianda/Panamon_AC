        </a>
    </li>
    <li class="nav-item">
        <a href="/ACOEE/Quality" class="@ActiveWhen("/acoee/quality")">
            <i class="fa-solid fa-check-circle"></i>
            <span class="nav-label">Quality</span>
        </a>
    </li>
    <li class="nav-item">
        <a href="/ACOEE/Inventory" class="@ActiveWhen("/acoee/inventory")">
            <i class="fa-solid fa-boxes-stacked"></i>
            <span class="nav-label">Inventory</span>
        </a>
    </li>
    <li class="nav-item">
        <a href="/ProductionReport/index">
            <i class="fa-solid fa-layer-group"></i>
            <span class="nav-label">Assembly</span>
        </a>
    </li>
</ul>
