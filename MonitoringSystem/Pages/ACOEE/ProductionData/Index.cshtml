@page "/ACOEE/ProductionData"
@model MonitoringSystem.Pages.ACOEE.ProductionData.IndexModel
@{
    ViewData["Title"] = "Machine";

    var machines = new[]
    {
        "Evaporator", "Condenser",
        "Expander Li-chin", "Expander Kyoshin 635", "Expander Kyoshin 7",
        "400 Ton New", "300 Ton New", "300 Ton Old", "200 Ton", "110 Ton Amada", "110 Ton Komatsu",
        "Hairpin Bender 7row", "Hairpin Bender 14row", "Fix 80", "Fix 36", "Fix 12", "SF-250",
        "Eva Cutting New", "Eva Cutting Old", "HPV Condenser"
    };
    var shiftTimes = new[]
    {
        new[]
        {
            "07:00", "08:00", "09:00", "10:00", "11:00", "12:00", "13:00", "14:00", "15:00", "15:45"
        },
        new[]
        {
            "15:45", "17:00", "18:00", "19:00", "20:00", "21:00", "22:00", "23:00", "23:15"
        },
        new[]
        {
            "23:15", "00:00", "01:00", "02:00", "03:00", "04:00", "05:00", "06:00", "07:00"
        }
    };
}
<link rel="stylesheet" href="~/css/ac-oee-production.css" asp-append-version="true" />

<div class="panamon-production-page">
    <header class="production-header">
            <div class="production-page-label">
                <i class="fa-solid fa-chart-column" aria-hidden="true"></i>
                <span>Production Data</span>
            </div>

            <div class="machine-tabs-shell">
                <nav class="machine-tabs" id="productionMachineTabs" aria-label="AC machine selection">
                    @foreach (var machine in machines)
                    {
                        var usesDatabaseModel = machine is "Evaporator" or "Condenser";
                        var latestModel = usesDatabaseModel ? Model.LatestMachineModels[machine] : string.Empty;
                        <button class="machine-tab @(machine == "Evaporator" ? "active" : null)"
                                type="button"
                                data-machine="@machine"
                                data-uses-database-model="@usesDatabaseModel.ToString().ToLowerInvariant()"
                                data-model="@latestModel">
                            @if (machine == "Expander Li-chin")
                            {
                                <text>Expander<br />Li-chin</text>
                            }
                            else
                            {
                                @machine
                            }
                        </button>
                    }
                </nav>
                <div class="machine-tabs-controls" aria-label="Navigate machine list">
                    <button class="machine-tabs-arrow machine-tabs-previous" type="button"
                            aria-label="Show previous machines" aria-controls="productionMachineTabs">
                        <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                    </button>
                    <button class="machine-tabs-arrow machine-tabs-next" type="button"
                            aria-label="Show more machines" aria-controls="productionMachineTabs">
                        <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            <input id="productionDatePicker" type="hidden" />
    </header>

    <main class="production-main">
            <section class="production-overview">
                <div class="machine-title-panel">
                    <span></span>
                    <h1 id="productionMachineTitle">EVAPORATOR</h1>
                    <i class="fa-solid fa-chart-column"></i>
                </div>
                <article class="glass-panel model-panel">
                    <h2>MODEL NAME</h2>
                    <strong id="productionModelName">@(string.IsNullOrWhiteSpace(Model.LatestMachineModels["Evaporator"]) ? "-" : Model.LatestMachineModels["Evaporator"])</strong>
                    <dl>
                        <div><dt>PRODUCTION PLAN</dt><dd><span>:</span> <output id="productionPlanValue">...</output></dd></div>
                        <div><dt>PLAN BY SUT</dt><dd><span>:</span> <output id="planBySutValue">1170</output></dd></div>
                        <div><dt>ACTUAL</dt><dd><span>:</span> <output id="productionActualValue">...</output></dd></div>
                        <div><dt>DIFFERENCE</dt><dd id="productionDifference"><span>:</span> <output id="productionDifferenceValue">...</output></dd></div>
                        <div><dt>REMAINING</dt><dd id="productionRemainingValue"><span>:</span> <output>...</output></dd></div>
                        <div>
                            <dt>TOTAL NG</dt>
                            <dd class="under-development-value">
                                <span>:</span>
                                <small><i class="fa-solid fa-gear"></i><b>Under Development</b></small>
                            </dd>
                        </div>
                    </dl>
                </article>

                <article class="glass-panel oee-panel">
                    <svg class="production-gauge" id="productionOeeGauge" viewBox="0 0 240 240" role="img" aria-label="OEE 128 percent">
                        <g class="production-gauge-tracks">
                            <circle cx="120" cy="120" r="93" pathLength="100" />
                            <circle cx="120" cy="120" r="74" pathLength="100" />
                            <circle cx="120" cy="120" r="59" pathLength="100" />
                            <circle cx="120" cy="120" r="44" pathLength="100" />
                        </g>
                        <g class="production-gauge-values">
                            <circle class="ring-oee" id="productionOeeRing" cx="120" cy="120" r="93" pathLength="100" />
                            <circle class="ring-operating" id="productionOperatingRing" cx="120" cy="120" r="74" pathLength="100" />
                            <circle class="ring-ability" id="productionAbilityRing" cx="120" cy="120" r="59" pathLength="100" />
                            <circle class="ring-quality" id="productionQualityRing" cx="120" cy="120" r="44" pathLength="100" />
                        </g>
                        <text id="productionOeeValue" x="120" y="132">128%</text>
                    </svg>
                    <div class="gauge-legend">
                        <span><i class="legend-dot oee"></i><span id="productionOeeLegend">OEE : 128%</span></span>
                        <span><i class="legend-dot ability"></i><span id="productionAbilityLegend">Ability : 180.1%</span></span>
                        <span><i class="legend-dot operating"></i><span id="productionOperatingLegend">Operating : 71.1%</span></span>
                        <span><i class="legend-dot quality"></i><span id="productionQualityLegend">Quality : 100%</span></span>
                    </div>
                </article>

                <article class="glass-panel chart-panel">
                    <header>
                        <h2>PLAN VS ACTUAL CHART</h2>
                        <div class="chart-legend"><span><i class="legend-dot plan"></i>Plan</span><span><i class="legend-dot actual"></i>Actual</span></div>
                    </header>
                    <div class="chart-body">
                        <span class="axis-title axis-y">Quantity</span>
                        <svg class="plan-chart" viewBox="0 0 910 250" preserveAspectRatio="none" role="img" aria-label="Plan and actual production chart">
                            <defs>
                                <linearGradient id="planGradient" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#287cf4" stop-opacity=".65" /><stop offset="1" stop-color="#287cf4" stop-opacity=".12" /></linearGradient>
                                <linearGradient id="actualGradient" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#11c2bd" stop-opacity=".45" /><stop offset="1" stop-color="#11c2bd" stop-opacity=".08" /></linearGradient>
                            </defs>
                            <g class="chart-grid">
                                <path d="M56 14H894 M56 114H894 M56 214H894" />
                                <path d="M56 14V214 M307.4 14V214 M558.8 14V214 M810.2 14V214 M894 14V214" />
                            </g>
                            <g class="y-labels"><text x="46" y="19">100</text><text x="46" y="119">50</text><text x="46" y="219">0</text></g>
                            <path class="plan-fill" d="M56 214 L307.4 166 L558.8 118 L810.2 70 L894 54 L894 214 L56 214 Z" />
                            <path class="actual-fill" d="M56 214 L307.4 171.33 L558.8 128.67 L810.2 86 L894 71.78 L894 214 L56 214 Z" />
                            <path class="plan-line" d="M56 214 L307.4 166 L558.8 118 L810.2 70 L894 54" />
                            <path class="actual-line" d="M56 214 L307.4 171.33 L558.8 128.67 L810.2 86 L894 71.78" />
                            <g class="plan-points"><circle cx="56" cy="214" r="4"/><circle cx="307.4" cy="166" r="4"/><circle cx="558.8" cy="118" r="4"/><circle cx="810.2" cy="70" r="4"/><circle cx="894" cy="54" r="4"/></g>
                            <g class="actual-points"><circle cx="56" cy="214" r="4"/><circle cx="307.4" cy="171.33" r="4"/><circle cx="558.8" cy="128.67" r="4"/><circle cx="810.2" cy="86" r="4"/><circle cx="894" cy="71.78" r="4"/></g>
                            <g class="x-labels"><text x="56" y="234">07:00</text><text x="307.4" y="234">08:00</text><text x="558.8" y="234">09:00</text><text x="810.2" y="234">10:00</text><text x="894" y="234">10:20</text></g>
                        </svg>
                        <span class="axis-title axis-x">Hour</span>
                    </div>
                </article>
            </section>

            <section class="detail-grid">
                <article class="glass-panel shift-summary">
                    <div class="shift-block shift-one">
                        <strong><i></i>SHIFT #1</strong>
                        <dl><div><dt>WORKING TIME</dt><dd>: <b>473</b></dd></div><div><dt>STOP TIME</dt><dd>: <b>7</b></dd></div><div><dt>LOAD TIME</dt><dd>: <b>159</b></dd></div></dl>
                    </div>
                    <div class="shift-block shift-two">
                        <strong><i></i>SHIFT #2</strong>
                        <dl><div><dt>WORKING TIME</dt><dd>: 0</dd></div><div><dt>STOP TIME</dt><dd>: 0</dd></div><div><dt>LOAD TIME</dt><dd>: 0</dd></div></dl>
                    </div>
                    <div class="shift-block shift-three">
                        <strong><i></i>SHIFT #3</strong>
                        <dl><div><dt>WORKING TIME</dt><dd>: 0</dd></div><div><dt>STOP TIME</dt><dd>: 0</dd></div><div><dt>LOAD TIME</dt><dd>: 0</dd></div></dl>
                    </div>
                </article>

                <article class="glass-panel timeline-panel">
                    <div class="timeline-legend" aria-label="Timeline status legend">
                        <span><i class="run"></i>Run</span>
                        <span><i class="stop"></i>Stop</span>
                        <span><i class="break"></i>Break</span>
                    </div>
                    @for (var shift = 1; shift <= 3; shift++)
                    {
                        <div class="timeline-row shift-@shift">
                            <h3>SHIFT @shift</h3>
                            <div class="timeline-wrap">
                                <div class="timeline-track">
                                    @if (shift == 1)
                                    {
                                        <i class="segment run-segment" style="--left:0%;--width:8.5714%"></i><i class="segment stop-segment" style="--left:8.5714%;--width:1.3333%"></i><i class="segment run-segment" style="--left:9.9048%;--width:18.6666%"></i><i class="segment break-segment" style="--left:28.5714%;--width:0.9524%"></i><i class="segment run-segment" style="--left:29.5238%;--width:8.5714%"></i>
                                    }
                                </div>
                                <div class="time-labels">
                                    @foreach (var time in shiftTimes[shift - 1])
                                    {
                                        <span>@time</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </article>
            </section>
    </main>
</div>

@section Scripts {
    <script src="~/js/ac-oee-production.js" asp-append-version="true"></script>
}
