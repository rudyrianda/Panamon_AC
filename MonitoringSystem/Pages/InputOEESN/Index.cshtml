@page
@model MonitoringSystem.Pages.InputOEESN.IndexModel
@{
    ViewData["Title"] = "Input Data OEESN";
}

<div class="container-fluid mt-4 mb-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="fas fa-database me-2"></i> Insert Rentang Serial (SN) ke Tabel OEESN</h4>
        </div>
        <div class="card-body bg-light">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <strong>Sukses!</strong> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>Error!</strong> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form method="post" class="bg-white p-4 border rounded shadow-sm">
                <h5 class="text-secondary border-bottom pb-2 mb-4">Parameter Serial Number (Rentang Data)</h5>
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">SN_GOOD Mulai (Start) <span class="text-danger">*</span></label>
                        <input type="number" asp-for="SnStart" class="form-control" required placeholder="Contoh: 34861531300" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">SN_GOOD Sampai (End) <span class="text-danger">*</span></label>
                        <input type="number" asp-for="SnEnd" class="form-control" required placeholder="Contoh: 34861531350" />
                    </div>
                </div>

                <h5 class="text-secondary border-bottom pb-2 mb-4 mt-4">Detail Data Produksi</h5>
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Product ID</label>
                        <input type="text" asp-for="ProductId" class="form-control" placeholder="Contoh: 348" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Machine Code</label>
                        <input type="text" asp-for="MachineCode" class="form-control" placeholder="Contoh: MCH1-02" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Shift Mode</label>
                        <input type="text" asp-for="ShiftMode" class="form-control" placeholder="Biarkan kosong jika NULL" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">P_Target</label>
                        <input type="number" step="0.01" asp-for="PTarget" class="form-control" placeholder="Contoh: 4.00" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Performance Mesin</label>
                        <input type="number" step="0.01" asp-for="Performance" class="form-control" placeholder="Contoh: 101.14" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Target Unit</label>
                        <input type="number" asp-for="TargetUnit" class="form-control" value="0" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Good Unit</label>
                        <input type="number" asp-for="GoodUnit" class="form-control" value="0" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Total Unit</label>
                        <input type="number" asp-for="TotalUnit" class="form-control" value="0" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Cycle Time</label>
                        <input type="number" asp-for="CycleTime" class="form-control" placeholder="Contoh: 51" />
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Hari / Tgl / Jam (SDate & Date)</label>
                        <input type="datetime-local" asp-for="InputDate" class="form-control" step="1" required />
                        <small class="text-muted">Akan mengisi otomatis kolom Date dan SDate di database.</small>
                    </div>
                </div>

                <hr class="mt-4 mb-4"/>
                
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg" onclick="return confirm('Apakah Anda yakin ingin memasukkan rentang data SN ini secara massal ke database?');">
                        <i class="fas fa-save me-2"></i> Eksekusi Insert Data ke Database
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
