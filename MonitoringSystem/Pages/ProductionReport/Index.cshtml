    /* Pa Adan Disini */
    
    bool IsWeekend(int day) {
        if (day < 1 || day > Model.DaysInMonth) return false;
        var date = new DateTime(Model.SelectedYear, Model.SelectedMonth, day);
        return date.DayOfWeek == DayOfWeek.Saturday || date.DayOfWeek == DayOfWeek.Sunday;
    }
}

